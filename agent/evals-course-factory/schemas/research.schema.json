{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson Research",
  "type": "object",
  "required": ["epic_id", "context_revision", "plan_revision", "sources", "claims", "coverage", "evidence_gaps"],
  "properties": {
    "epic_id": {"type": "string", "pattern": "^EP-[0-9]{2}$"},
    "context_revision": {"type": "integer", "minimum": 0},
    "plan_revision": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "authors", "year", "source_type", "url", "authority_note"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
          "title": {"type": "string"},
          "authors": {"type": "array", "items": {"type": "string"}},
          "year": {"type": "integer", "minimum": 1900},
          "source_type": {"enum": ["paper", "standard", "official_documentation", "authoritative_technical", "secondary"]},
          "url": {"type": "string", "format": "uri"},
          "doi_or_arxiv": {"type": ["string", "null"]},
          "authority_note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "source_ids", "source_locator", "support", "scope", "limitations", "inference", "user_story_ids"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
          "claim": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}},
          "source_locator": {"type": "string"},
          "support": {"type": "string"},
          "scope": {"type": "string"},
          "limitations": {"type": "string"},
          "inference": {"type": "boolean"},
          "user_story_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^US-L[0-9]{2}-[0-9]{2}$"}}
        },
        "additionalProperties": false
      }
    },
    "coverage": {"type": "array", "items": {"type": "object", "required": ["user_story_id", "claim_ids", "status"], "properties": {"user_story_id": {"type": "string"}, "claim_ids": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["covered", "partial", "gap"]}}, "additionalProperties": false}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
