{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One Lesson Plan",
  "type": "object",
  "required": ["epic_id", "context_revision", "plan_revision", "title", "purpose", "prerequisites", "user_stories", "build_along", "capstone_trace"],
  "properties": {
    "epic_id": {"type": "string", "pattern": "^EP-[0-9]{2}$"},
    "context_revision": {"type": "integer", "minimum": 0},
    "plan_revision": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "purpose": {"type": "string"},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "user_stories": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["user_story_id", "title", "statement", "one_idea", "checkpoints", "acceptance_criteria", "estimated_minutes", "depends_on"],
        "properties": {
          "user_story_id": {"type": "string", "pattern": "^US-L[0-9]{2}-[0-9]{2}$"},
          "title": {"type": "string"},
          "statement": {"type": "string"},
          "one_idea": {"type": "string"},
          "checkpoints": {"type": "array", "items": {"type": "object", "required": ["checkpoint_id", "capability", "observable_check"], "properties": {"checkpoint_id": {"type": "string", "pattern": "^CP-L[0-9]{2}-[0-9]{2}-[A-Z]$"}, "capability": {"type": "string"}, "observable_check": {"type": "string"}}, "additionalProperties": false}},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
          "estimated_minutes": {"type": "number", "minimum": 2, "maximum": 3},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "build_along": {"type": "object", "required": ["estimated_minutes", "input_artifact", "output_artifact", "visible_checks", "offline_replay"], "properties": {"estimated_minutes": {"type": "number", "exclusiveMinimum": 0, "maximum": 20}, "input_artifact": {"type": ["string", "null"]}, "output_artifact": {"type": "string"}, "visible_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "offline_replay": {"type": "string"}}, "additionalProperties": false},
    "capstone_trace": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
